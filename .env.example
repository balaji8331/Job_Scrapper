# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single-user id until you add Supabase Auth
JOB_OS_USER_ID=00000000-0000-4000-a000-000000000001

# Adzuna India (free developer key) — main volume source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google AI Studio key (not Jio Gemini Pro). Optional: rules ranking still works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: RapidAPI JSearch if Adzuna + company portals are under 40 matches
RAPIDAPI_KEY=
